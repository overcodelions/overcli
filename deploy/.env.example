# Copy to deploy/.env. Never commit the real one.

# Which server image to run: a minor version takes its fixes, a full one
# (0.22.0) stays exactly put. Unset: the latest release.
# OVERCLI_VERSION=0.22
# Set to 0 on a server with no internet access: no daily check for a newer
# release on GitHub.
# OVERCLI_UPDATE_CHECK=0

# The model. Claude Code reads these; set one way.
# An Anthropic API key:
ANTHROPIC_API_KEY=
# …or Bedrock (with PrivateLink, model traffic stays inside AWS):
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# …or Vertex:
# CLAUDE_CODE_USE_VERTEX=1
# CLOUD_ML_REGION=us-east5
# ANTHROPIC_VERTEX_PROJECT_ID=

# Codex, if the image was built with INSTALL_CODEX=1:
# OPENAI_API_KEY=

# Behind a reverse proxy or load balancer that sets X-Forwarded-For/-Host/
# -Proto, believe those headers (rate limits per person, links built from
# the address people used). Leave unset when clients reach overcli directly.
# OVERCLI_TRUST_PROXY=1

# Company sign-in: a confidential OIDC client's secret (the rest is set on
# Admin → Rules → Sign-in). Leave unset for a public client.
# OVERCLI_SSO_CLIENT_SECRET=

# Where the secrets admins set on Setup → Secrets are kept (git host tokens,
# Slack tokens, the SSO client secret). Set them there, not here: they apply at
# once, with no restart. Anything also set in this file wins.
#   (unset)                  an encrypted file on the data volume
#   aws:overcli/acme/        AWS Secrets Manager, through the instance or task role
#   gcp:<project>/overcli-   GCP Secret Manager, through the service account
# OVERCLI_SECRETS=
# For the encrypted file: the key, kept apart from the volume (from your cloud's
# secret manager, say). Unset, a key file is made beside the secrets.
# OVERCLI_SECRETS_KEY=
# Managed elsewhere (Terraform): the console lists them, changes nothing.
# OVERCLI_SECRETS_READONLY=1

# Repo tests before a push. By default they do not run: the server's own user
# can read its secrets, so running a repo's test command as it is refused.
# Until you choose one of the settings below, a repo with a test command
# pushes nothing: each finished run says "repo tests are turned off on this
# server", and the Repos tab says so too. Repos with no test command push as
# usual. Either run tests as a user that cannot read /data (a numeric id, not
# 0; the server needs leave to switch user: root or CAP_SETUID, and the
# published image runs as `node` and cannot), or accept running them as the
# server, deliberately.
# OVERCLI_TEST_UID=1001
# OVERCLI_TEST_GID=1001
# OVERCLI_TEST_AS_SERVER=1

# Slack (src/main/slack/slack-app-manifest.yml makes the app).
OVERCLI_SLACK_BOT_TOKEN=
OVERCLI_SLACK_APP_TOKEN=

# Remote tools' tokens stay sealed in the server and workers reach them
# through a loopback gateway. On in the Docker image; 0 turns it off and puts
# the tools back in the CLIs' config on the next start.
# OVERCLI_TOOL_GATEWAY=0
