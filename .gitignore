node_modules/
dist/
coverage/
release/
docs/*
# The user guide ships in the repo; the rest of docs/ is scratch.
!docs/guide/
# The org docs ship in the repo and the image; only scratch docs/ stays out.
!deploy/docs/
.mender/

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.DS_Store
Thumbs.db

.claude/

# Defensive: some users have a global ignore (e.g. `*log.*`) that would
# otherwise swallow CHANGELOG.md. Force it to be tracked.
!CHANGELOG.md
.mockups/

# Local scratch registry for hand-testing flow installs.
example-registry/

# Design canvas working files (seeded into the published canvas, not app source)
.design-*/

# Deployment secrets
deploy/.env
